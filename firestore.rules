rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // App data (full D snapshot) — each user only their own doc
    match /appData/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }
    // Push subscriptions — private to the owner; the scheduled function uses the Admin SDK
    match /pushSubscriptions/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }
    // Private account profile data is visible only to its owner.
    match /users/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }
    // Invite codes are unguessable document IDs, directly fetched by the person
    // who received the code. Listing codes would expose accounts and invites.
    match /pairingCodes/{code} {
      allow get: if request.auth != null &&
        (resource.data.ownerEmail == request.auth.token.email ||
         resource.data.consumedBy == request.auth.token.email ||
         (resource.data.expiresAt > request.time && resource.data.consumed != true));
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.code == code &&
        request.resource.data.expiresAt > request.time;
      allow update: if request.auth != null &&
        (resource.data.ownerEmail == request.auth.token.email ||
         (resource.data.expiresAt > request.time && resource.data.accepted != true &&
          ((resource.data.consumed != true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumed', 'consumedBy', 'consumedAt', 'requestName', 'requestLanguage'])) ||
           (resource.data.consumedBy == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawn'])))));
      allow delete: if request.auth != null && resource.data.ownerEmail == request.auth.token.email;
    }
    // Buddy progress shares: readable only to the owner and the partners they explicitly share with
    match /progress/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || (resource.data is map && resource.data.participants is list && request.auth.token.email in resource.data.participants));
      allow write: if request.auth != null && request.auth.token.email == email;
    }
    // Buddy messages: a user can read only conversations they are part of
    match /messages/{message} {
      allow read: if request.auth != null && (resource.data.from == request.auth.token.email || resource.data.to == request.auth.token.email);
      allow create: if request.auth != null && request.resource.data.from == request.auth.token.email;
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.from == request.auth.token.email || resource.data.to == request.auth.token.email);
    }
    // Recommendations/feedback: create only under your own email, read only your own submissions
    match /recommendations/{id} {
      allow create: if request.auth != null && request.resource.data.email == request.auth.token.email;
      allow read: if request.auth != null && resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }
    // Everything else is locked down
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
